# Copy this file to .env and fill it in, or run: python set_keys.py
# .env is never committed. This file holds no values on purpose.

# Required for every step. SEC EDGAR asks every program for a name and an email,
# as in: SEC_USER_AGENT=Your Name your.email@university.edu
SEC_USER_AGENT=

# Required for the roles and the Verifier: one model key. The key picks the provider.
# An Anthropic key starts with sk-ant- (from platform.claude.com).
# A Google AI Studio key starts with AIza (from aistudio.google.com).
API_KEY=

# Optional: the model and the effort the roles use. Without them the desk uses
# claude-opus-5-5 for an Anthropic key and gemini-3.8-flash for a Google key.
# EFFORT applies to Anthropic models only.
# MODEL=
# EFFORT=

# Optional: a closing price for P/E. Without one, the report has no P/E.
# LSEG Workspace: the App Key, with the Workspace desktop app running and signed in.
# LSEG_APP_KEY=
# Or a CSV file of closes exported from Workspace. Keep the file OUTSIDE this folder.
# CLOSES_FILE=
# A ticker's RIC when the reader cannot find it (TICKER=RIC, with commas), and the LSEG field to read.
# LSEG_RICS=
# LSEG_CLOSE_FIELD=
# The class key for financialdatasets.ai, used when the closes reader has no close.
FINANCIAL_DATASETS_API_KEY=

# Optional: the AI tools named on each report's AI-assistance line.
# AI_TOOLS=
